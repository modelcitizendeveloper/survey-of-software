{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{- /* Exclude noindex pages (the generated survey leaves) from the sitemap. */ -}}
  {{- range site.Pages }}
    {{- if and .Permalink (not .Params.noindex) }}
  <url>
    <loc>{{ .Permalink }}</loc>{{ if not .Lastmod.IsZero }}
    <lastmod>{{ safeHTML ( .Lastmod.Format "2006-01-02T15:04:05-07:00" ) }}</lastmod>{{ end }}
  </url>
    {{- end }}
  {{- end }}
  {{- /* Standalone Workshop apps live in static/ so they ship untouched by the
         theme, which means Hugo does not know about them and cannot sitemap
         them automatically. They are indexable (the noindex cascade only
         targets /survey/**), so without this they would be crawlable only via
         inbound links. List them here by hand; there will not be many. */ -}}
  {{- range slice "/workshop/sortie/" }}
  <url>
    <loc>{{ . | absURL }}</loc>
  </url>
  {{- end }}
</urlset>
